#!/usr/bin/env python3
"""
Generate IEEE 754 golden vectors for the float and double codecs.

The corpus is enumerated, not sampled, so the output is byte-identical on every host.

Two oracles, neither of them a hand-written literal: `ctypes.c_float` for the
double-to-float narrowing, which is the C cast the hardware performs, and
`struct.pack` for the bytes. Three of the first expectations hand-computed for this
work were themselves wrong, which is why nothing here is written by hand.

Each vector carries `units` and `scale` so the test can assert its own decimal
literals parsed to the exact intended rational. `value` and `input` are read back by
`strtod`, and a midpoint that parses to a neighbour instead would still encode to the
golden, i.e. it would pass while testing nothing.
"""
import argparse
import ctypes
import math
import os
import struct
import sys

# A double below this is a float32 subnormal; at or above it, a normal.
FLOAT_MIN_NORMAL = 2.0 ** -126
FLOAT_SUBNORMAL_ULP = 2.0 ** -149
DOUBLE_SUBNORMAL_ULP = 5e-324
MANTISSA32 = 1 << 23
MANTISSA64 = 1 << 52

INF = float("inf")
NAN = float("nan")


def narrow(value: float) -> float:
    """The C `(float)` cast: round to nearest float32, ties to even, overflow to inf."""
    return ctypes.c_float(value).value


def pack(value: float, width: int) -> bytes:
    """`value` must already be representable at `width`, so this never rounds."""
    return struct.pack("<f" if width == 4 else "<d", value)


def decompose(value: float):
    """
    Return `(units, scale)` with `value == units * 2 ** -scale` and `units` odd.

    Odd, so `units` fits a double exactly whatever the magnitude; `scale` carries the
    rest and goes negative for the large end.
    """
    numerator, denominator = value.as_integer_ratio()
    scale = denominator.bit_length() - 1
    while numerator != 0 and numerator % 2 == 0:
        numerator //= 2
        scale -= 1
    return numerator, scale


def scale_pair(scale: int):
    """
    Split `scale` so neither `2 ** half` leaves the normal range.

    A subnormal double needs a scale of 1074 and `2 ** 1074` is infinity.
    """
    if abs(scale) <= 1000:
        return scale, 0
    half = scale // 2
    return half, scale - half


# -- Lua rendering -----------------------------------------------------------


def lua_bytes(raw: bytes) -> str:
    """Hex, decoded at load time. Decimal escapes are variable-width: `\\10` then a
    "0" byte reads back as `\\100`, which corrupted three vectors in lua-protobuf#27."""
    return 'B("%s")' % raw.hex()


def lua_number(value: float) -> str:
    """Shortest decimal that round-trips, which `repr` gives for every double."""
    if value != value:
        return "(0 / 0)"
    if value == INF:
        return "math.huge"
    if value == -INF:
        return "-math.huge"
    if value == 0.0:
        # Lua 5.1 constant-folds the literal -0.0 to +0.0, so a corpus written that way
        # tests the wrong value there and nowhere else. src/protobuf/init.lua builds its
        # own NEG_ZERO the same way for the same reason.
        return "(-1 / math.huge)" if math.copysign(1.0, value) < 0 else "0.0"
    return repr(value)


def render_vector(vector) -> str:
    parts = [
        "name = %s" % lua_string(vector["name"]),
        "width = %d" % vector["width"],
        "golden = %s" % lua_bytes(vector["golden"]),
        "value = %s" % lua_number(vector["value"]),
    ]
    if math.isfinite(vector["value"]):
        units, scale = decompose(vector["value"])
        first, second = scale_pair(scale)
        parts.append("units = %d" % units)
        parts.append("scale = { %d, %d }" % (first, second))
    if "input" in vector:
        parts.append("input = %s" % lua_number(vector["input"]))
        units, scale = decompose(vector["input"])
        first, second = scale_pair(scale)
        parts.append("input_units = %d" % units)
        parts.append("input_scale = { %d, %d }" % (first, second))
    if vector.get("decode_only"):
        parts.append("decode_only = true")
    return "  { %s },\n" % ", ".join(parts)


def lua_string(text: str) -> str:
    return '"%s"' % text.replace("\\", "\\\\").replace('"', '\\"')


# -- Corpus ------------------------------------------------------------------


def classify(value: float, width: int) -> str:
    """Which band `value` actually lands in at `width` bytes."""
    if value != value:
        return "nan"
    if value in (INF, -INF):
        return "infinity"
    if value == 0.0:
        return "zero"
    limit = FLOAT_MIN_NORMAL if width == 4 else 2.0 ** -1022
    return "subnormal" if abs(value) < limit else "normal"


# The band a vector's name claims, against what its value is. The test groups its
# per-bucket counts by this token, so a mislabelled vector makes the table lie about
# which arm ran: 1e-308 is a subnormal double, and a "normal" name hid that.
DECLARED_BANDS = {
    "subnormal": ("subnormal",),
    "normal": ("normal",),
    "underflow": ("zero",),
    "overflow": ("normal", "infinity"),
}


class Corpus:
    def __init__(self):
        self.vectors = []
        self.seen = set()

    def add(self, name: str, width: int, input_value: float, decode_only=False):
        """
        Add one vector, deriving the expected value from the oracle.

        `input_value` is what the encoder is handed; the expected value is what the
        cast produces, so a rounding case and an exact one are written the same way.
        """
        value = narrow(input_value) if width == 4 else input_value
        vector = {
            "name": name,
            "width": width,
            "golden": pack(value, width),
            "value": value,
        }
        # Bit-identical, not ==: an input of -0.0 with a value of 0.0 is a real case.
        if struct.pack("<d", input_value) != struct.pack("<d", value):
            vector["input"] = input_value
        if decode_only:
            vector["decode_only"] = True
        self._append(vector)

    def add_golden(self, name: str, width: int, golden: bytes, value: float):
        """
        Add a decode-only vector from bytes the encoder cannot produce.

        A non-canonical NaN payload is a real wire input, but every encoder emits its
        own canonical form, so asserting the encode direction on one would fail.
        """
        assert len(golden) == width, name
        self._append({
            "name": name,
            "width": width,
            "golden": golden,
            "value": value,
            "decode_only": True,
        })

    def _append(self, vector):
        if vector["name"] in self.seen:
            raise SystemExit("duplicate vector name: %s" % vector["name"])
        declared = vector["name"].split()[1]
        allowed = DECLARED_BANDS.get(declared)
        actual = classify(vector["value"], vector["width"])
        if allowed and actual not in allowed:
            raise SystemExit("%s: name says %s, value is %s" % (vector["name"], declared, actual))
        self.seen.add(vector["name"])
        self.vectors.append(vector)


def float_subnormals(corpus: Corpus):
    """The band the decoder applies a leading one to and the encoder flushes to zero."""
    def value_of(mantissa):
        return mantissa * FLOAT_SUBNORMAL_ULP

    for exponent in range(127, 150):
        corpus.add("f32 subnormal 2^-%d" % exponent, 4, 2.0 ** -exponent)

    for bits in range(1, 24):
        mantissa = (1 << bits) - 1
        corpus.add("f32 subnormal mantissa 2^%d-1" % bits, 4, value_of(mantissa))

    for mantissa in range(1, 49):
        corpus.add("f32 subnormal mantissa %d" % mantissa, 4, value_of(mantissa))

    for mantissa in range(MANTISSA32 - 64, MANTISSA32):
        corpus.add("f32 subnormal mantissa 0x%06X" % mantissa, 4, value_of(mantissa))

    for mantissa in (0x555555, 0x2AAAAA, 0x333333, 0x0F0F0F, 0x7F7F7F, 0x400000, 0x400001):
        corpus.add("f32 subnormal mantissa 0x%06X pattern" % mantissa, 4, value_of(mantissa))

    for exponent in range(127, 150):
        corpus.add("f32 subnormal -2^-%d" % exponent, 4, -(2.0 ** -exponent))
    corpus.add("f32 subnormal negative max", 4, -value_of(MANTISSA32 - 1))
    corpus.add("f32 subnormal negative min", 4, -FLOAT_SUBNORMAL_ULP)

    # Doubles inside the band that are not midpoints: ordinary round to nearest.
    for name, value in (
        ("1e-40", 1e-40),
        ("1e-44", 1e-44),
        ("3e-45", 3e-45),
        ("7.5e-46", 7.5e-46),
        ("1.2345678e-43", 1.2345678e-43),
        ("9.87654321e-39", 9.87654321e-39),
        ("2^-149*2/3", FLOAT_SUBNORMAL_ULP * 2 / 3),
        ("2^-127*0.9", 2.0 ** -127 * 0.9),
    ):
        corpus.add("f32 subnormal inexact %s" % name, 4, value)


def float_subnormal_ties(corpus: Corpus):
    """
    Midpoints between adjacent subnormals, where round-half-up and half-even differ.

    `mantissa + 0.5` is exact as a double, so the input is the true midpoint.
    """
    def midpoint(mantissa):
        return (2 * mantissa + 1) * (FLOAT_SUBNORMAL_ULP / 2)

    def tie(label, input_value):
        """The band comes from the oracle, so a midpoint that leaves the subnormal
        range is filed where it lands: 0.5 ulp rounds to zero and the top one carries
        into the smallest normal."""
        band = {"zero": "underflow", "normal": "normal", "subnormal": "subnormal"}
        corpus.add("f32 %s tie %s" % (band[classify(narrow(input_value), 4)], label), 4, input_value)

    for mantissa in range(0, 48):
        tie("%d.5" % mantissa, midpoint(mantissa))

    for mantissa in (0x3FFFFF, 0x400000, 0x400001, MANTISSA32 - 2, MANTISSA32 - 1):
        tie("0x%06X.5" % mantissa, midpoint(mantissa))

    tie("0.5 negative", -midpoint(0))
    tie("1.5 negative", -midpoint(1))
    tie("max negative", -midpoint(MANTISSA32 - 1))

    # Below the first midpoint: every one of these flushes to zero, sign preserved.
    for name, value in (
        ("7e-46", 7e-46),
        ("2^-149/3", FLOAT_SUBNORMAL_ULP / 3),
        ("2^-151", 2.0 ** -151),
        ("2^-200", 2.0 ** -200),
        ("2^-1074", DOUBLE_SUBNORMAL_ULP),
        ("1e-60", 1e-60),
    ):
        corpus.add("f32 underflow %s" % name, 4, value)
        corpus.add("f32 underflow -%s" % name, 4, -value)

    # Either side of the first midpoint, which is the flush-to-zero decision itself.
    corpus.add("f32 underflow just under 2^-150", 4, math.nextafter(2.0 ** -150, 0.0))
    corpus.add("f32 subnormal just over 2^-150", 4, math.nextafter(2.0 ** -150, 1.0))


def float_normals(corpus: Corpus):
    """One midpoint per binade in each half-even direction, plus the band boundaries."""
    for exponent in range(-126, 128):
        ulp = 2.0 ** (exponent - 23)
        base = 2.0 ** exponent
        # Mantissa 0 is even, so this rounds down; mantissa 1 is odd, so this rounds up.
        corpus.add("f32 normal tie 2^%d+0.5ulp" % exponent, 4, base + ulp / 2)
        corpus.add("f32 normal tie 2^%d+1.5ulp" % exponent, 4, base + ulp + ulp / 2)

    # The top of a binade, where rounding up carries into the exponent.
    for exponent in list(range(-126, 128, 8)) + [-125, 126, 127]:
        ulp = 2.0 ** (exponent - 23)
        top = 2.0 ** (exponent + 1) - ulp
        corpus.add("f32 normal tie top of 2^%d" % exponent, 4, top - ulp / 2)

    corpus.add("f32 normal min", 4, FLOAT_MIN_NORMAL)
    corpus.add("f32 normal min plus ulp", 4, FLOAT_MIN_NORMAL + 2.0 ** -149)
    corpus.add("f32 normal min negative", 4, -FLOAT_MIN_NORMAL)
    corpus.add("f32 normal 2^-125", 4, 2.0 ** -125)

    for name, value in (
        ("1.0", 1.0),
        ("-1.0", -1.0),
        ("0.5", 0.5),
        ("2.0", 2.0),
        ("pi", narrow(math.pi)),
        ("-pi", narrow(-math.pi)),
        ("max", narrow(3.4028234663852886e38)),
        ("-max", narrow(-3.4028234663852886e38)),
        ("1/3", narrow(1.0 / 3.0)),
        ("1e10", narrow(1e10)),
        ("1e-10", narrow(1e-10)),
        ("123456.78", narrow(123456.78)),
    ):
        corpus.add("f32 normal exact %s" % name, 4, value)

    for name, value in (
        ("0.1", 0.1),
        ("1/3", 1.0 / 3.0),
        ("pi", math.pi),
        ("e", math.e),
        ("1e20", 1e20),
        ("1e-20", 1e-20),
        ("-0.1", -0.1),
    ):
        corpus.add("f32 normal inexact %s" % name, 4, value)


def float_overflow(corpus: Corpus):
    """
    The finite-to-infinite decision, which is a rounding decision too.

    The midpoint between the largest float and 2^128 rounds to infinity, because the
    tie goes to the candidate with the even mantissa and that is the overflowing one.
    """
    largest = narrow(3.4028234663852886e38)
    overflow_tie = 2.0 ** 128 - 2.0 ** 103
    corpus.add("f32 overflow largest finite", 4, largest)
    corpus.add("f32 overflow just over largest", 4, math.nextafter(largest, INF))
    corpus.add("f32 overflow tie to infinity", 4, overflow_tie)
    corpus.add("f32 overflow just under tie", 4, math.nextafter(overflow_tie, 0.0))
    corpus.add("f32 overflow just over tie", 4, math.nextafter(overflow_tie, INF))
    corpus.add("f32 overflow 2^128", 4, 2.0 ** 128)
    corpus.add("f32 overflow 1e39", 4, 1e39)
    corpus.add("f32 overflow double max", 4, 1.7976931348623157e308)
    corpus.add("f32 overflow -tie to infinity", 4, -overflow_tie)
    corpus.add("f32 overflow -1e39", 4, -1e39)


def float_specials(corpus: Corpus):
    corpus.add("f32 zero", 4, 0.0)
    corpus.add("f32 negative zero", 4, -0.0)
    corpus.add("f32 infinity", 4, INF)
    corpus.add("f32 negative infinity", 4, -INF)
    corpus.add("f32 nan", 4, NAN)
    corpus.add_golden("f32 nan smallest payload", 4, struct.pack("<I", 0x7F800001), NAN)
    corpus.add_golden("f32 nan largest signalling", 4, struct.pack("<I", 0x7FBFFFFF), NAN)
    corpus.add_golden("f32 nan all payload bits", 4, struct.pack("<I", 0x7FFFFFFF), NAN)
    corpus.add_golden("f32 nan negative", 4, struct.pack("<I", 0xFFC00000), NAN)


def double_subnormals(corpus: Corpus):
    def value_of(mantissa):
        return math.ldexp(float(mantissa), -1074)

    for exponent in range(1023, 1075):
        corpus.add("f64 subnormal 2^-%d" % exponent, 8, math.ldexp(1.0, -exponent))

    for bits in range(1, 53):
        corpus.add("f64 subnormal mantissa 2^%d-1" % bits, 8, value_of((1 << bits) - 1))

    for mantissa in range(1, 33):
        corpus.add("f64 subnormal mantissa %d" % mantissa, 8, value_of(mantissa))

    for mantissa in (
        0x5555555555555,
        0xAAAAAAAAAAAAA,
        0x8000000000000,
        0x8000000000001,
        0xFFFFFFFFFFFFE,
        0x123456789ABCD,
    ):
        corpus.add("f64 subnormal mantissa 0x%013X pattern" % mantissa, 8, value_of(mantissa))

    for exponent in range(1023, 1075, 2):
        corpus.add("f64 subnormal -2^-%d" % exponent, 8, -math.ldexp(1.0, -exponent))
    corpus.add("f64 subnormal negative max", 8, -value_of(MANTISSA64 - 1))
    corpus.add("f64 subnormal negative min", 8, -DOUBLE_SUBNORMAL_ULP)

    corpus.add("f64 subnormal max", 8, value_of(MANTISSA64 - 1))
    corpus.add("f64 normal min", 8, 2.0 ** -1022)
    corpus.add("f64 normal min plus ulp", 8, math.nextafter(2.0 ** -1022, INF))
    corpus.add("f64 normal second binade", 8, 2.0 ** -1021)

    for name, value in (
        ("1e-308", 1e-308),
        ("1e-310", 1e-310),
        ("1e-320", 1e-320),
        ("5e-324", 5e-324),
        ("2.2250738585072011e-308", 2.2250738585072011e-308),
    ):
        corpus.add("f64 subnormal %s" % name, 8, value)


def double_normals(corpus: Corpus):
    for exponent in range(-1021, 1024, 32):
        corpus.add("f64 normal 2^%d" % exponent, 8, math.ldexp(1.0, exponent))
        corpus.add("f64 normal 2^%d plus ulp" % exponent, 8,
                   math.nextafter(math.ldexp(1.0, exponent), INF))

    for name, value in (
        ("1.0", 1.0),
        ("-1.0", -1.0),
        ("0.5", 0.5),
        ("0.1", 0.1),
        ("1/3", 1.0 / 3.0),
        ("pi", math.pi),
        ("-pi", -math.pi),
        ("e", math.e),
        ("max", 1.7976931348623157e308),
        ("-max", -1.7976931348623157e308),
        ("min normal", 2.2250738585072014e-308),
        ("1e308", 1e308),
        ("123456789.123456789", 123456789.123456789),
        ("2^53", 2.0 ** 53),
        ("2^53-1", 2.0 ** 53 - 1),
    ):
        corpus.add("f64 normal %s" % name, 8, value)


def double_specials(corpus: Corpus):
    corpus.add("f64 zero", 8, 0.0)
    corpus.add("f64 negative zero", 8, -0.0)
    corpus.add("f64 infinity", 8, INF)
    corpus.add("f64 negative infinity", 8, -INF)
    corpus.add("f64 nan", 8, NAN)
    corpus.add_golden("f64 nan smallest payload", 8, struct.pack("<Q", 0x7FF0000000000001), NAN)
    corpus.add_golden("f64 nan all payload bits", 8, struct.pack("<Q", 0x7FFFFFFFFFFFFFFF), NAN)
    corpus.add_golden("f64 nan negative", 8, struct.pack("<Q", 0xFFF8000000000000), NAN)


def build_cases():
    corpus = Corpus()
    float_specials(corpus)
    float_subnormals(corpus)
    float_subnormal_ties(corpus)
    float_normals(corpus)
    float_overflow(corpus)
    double_specials(corpus)
    double_subnormals(corpus)
    double_normals(corpus)
    return corpus.vectors


# -- Output ------------------------------------------------------------------


HEADER = '''-- Generated IEEE 754 codec vectors. Do not edit manually.
--
-- Produced by tools/gen_float_vectors from the C float cast and struct.pack.
-- Regenerate with `make gen-float-vectors`; `make check-float-vectors` fails on
-- drift and re-checks both directions against the oracle.
--
-- `golden` is the canonical encoding of `value` at `width` bytes. `input` is present
-- only when it differs from `value`, i.e. when encoding it has to round or clamp.
-- `units` and `scale` state the exact rational each literal must parse to:
-- `value * 2 ^ scale[1] * 2 ^ scale[2] == units`.
-- `decode_only` marks a golden no encoder emits, such as a non-canonical NaN.

local function B(hex)
  if #hex % 2 ~= 0 then
    error("odd-length hex: " .. hex)
  end
  return (hex:gsub("%x%x", function(pair)
    return string.char(tonumber(pair, 16))
  end))
end

return {
'''


def render(vectors) -> str:
    return HEADER + "".join(render_vector(vector) for vector in vectors) + "}\n"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("output", help="Lua output file")
    args = parser.parse_args()

    vectors = build_cases()
    directory = os.path.dirname(args.output)
    if directory:
        os.makedirs(directory, exist_ok=True)
    with open(args.output, "w") as handle:
        handle.write(render(vectors))
    floats = sum(1 for vector in vectors if vector["width"] == 4)
    print("Wrote %d float and %d double vectors to %s" % (
        floats, len(vectors) - floats, args.output), file=sys.stderr)


if __name__ == "__main__":
    main()
